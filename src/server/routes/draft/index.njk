{% extends 'layouts/page.njk' %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="post" novalidate>
        <input type="hidden" name="actionKey" value="{{ actionKey }}">
        {{ govukRadios({
          name: "draftAction",
          fieldset: {
            legend: {
              html: '<span class="govuk-caption-l">' ~ caption ~ '</span>' ~ heading,
              isPageHeading: true,
              classes: "govuk-fieldset__legend--xl"
            }
          },
            errorMessage: { text: fieldErrors.draftAction } if fieldErrors.draftAction else false,
          items: [
            { value: "complete", text: t('web.draft.index.copy.21.1') },
            { value: "delete", text: t('web.draft.index.copy.22.1') }
          ]
        }) }}

        {{ govukButton({ text: t('common.button.saveAndContinue') }) }}
      </form>
    </div>
  </div>
{% endblock %}
