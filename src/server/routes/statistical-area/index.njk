{% extends 'layouts/page.njk' %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <form method="post" novalidate>
        <span class="govuk-caption-l">{{ caption }}</span>
        <h1 class="govuk-heading-xl app-statistical-area-map__heading">{{ heading }}</h1>

        {% for paragraph in bodyText %}
          <p class="govuk-body govuk-!-margin-bottom-5">{{ paragraph }}</p>
        {% endfor %}

        <div class="govuk-form-group{{ ' govuk-form-group--error' if fieldErrors.statisticalArea }}">
          {% if fieldErrors.statisticalArea %}
            <p id="statisticalArea-error" class="govuk-error-message">
              <span class="govuk-visually-hidden">Error:</span> {{ fieldErrors.statisticalArea }}
            </p>
          {% endif %}

          <div id="statisticalArea" class="app-statistical-area-map" aria-describedby="statisticalArea-hint{% if fieldErrors.statisticalArea %} statisticalArea-error{% endif %}">
            <p id="statisticalArea-hint" class="govuk-visually-hidden">Select one of the displayed area codes or choose Other.</p>

              <div class="app-offline-map" data-statistical-area-map data-selected-area="{{ selectedStatisticalArea or '' }}" data-departure-port="{{ departurePortName }}">
              <canvas class="app-offline-map__canvas" aria-label="Statistical area map. Select an area on the map."></canvas>
              <button class="app-offline-map__other" type="submit" name="statisticalArea" value="other">Other</button>
              <input type="hidden" name="statisticalArea" value="" disabled data-statistical-area-map-input>
              <p class="govuk-visually-hidden" aria-live="polite" data-statistical-area-map-status></p>
            </div>
          </div>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
