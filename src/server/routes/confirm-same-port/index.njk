{% extends 'layouts/page.njk' %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  {% set radioErrorMessage = { text: fieldErrors.confirmSamePort } if fieldErrors.confirmSamePort else false %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="post" action="{{ formAction }}" novalidate>
        {{ govukRadios({
          name: "confirmSamePort",
          fieldset: {
            legend: {
              html: '<span class="govuk-caption-l">' ~ caption ~ '</span>' ~ heading,
              isPageHeading: true,
              classes: "govuk-fieldset__legend--xl"
            }
          },
          errorMessage: radioErrorMessage,
          items: [
            { value: "yes", text: t('confirmSamePort.yes') },
            { value: "no", text: t('confirmSamePort.no') }
          ]
        }) }}

        {{ govukButton({ text: t('common.button.saveAndContinue') }) }}
      </form>
    </div>
  </div>
{% endblock %}
