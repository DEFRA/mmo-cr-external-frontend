{% extends 'layouts/page.njk' %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  {% set radioErrorMessage = { text: fieldErrors.confirmSamePort } if fieldErrors.confirmSamePort else false %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="post" action="{{ formAction }}" novalidate>
        {{ govukRadios({
          name: "confirmSamePort",
          fieldset: {
            legend: {
              html: '<span class="govuk-caption-l">' ~ caption ~ '</span>' ~ heading,
              isPageHeading: true,
              classes: "govuk-fieldset__legend--xl"
            }
          },
          errorMessage: radioErrorMessage,
          items: [
            { value: "yes", text: "Yes" },
            { value: "no", text: "No" }
          ]
        }) }}

        {{ govukButton({ text: "Save and continue" }) }}
        {{ govukButton({ text: "Add another port", href: "/add-port?for=departure&entry=1", classes: "govuk-button--secondary" }) }}
      </form>
    </div>
  </div>
{% endblock %}
