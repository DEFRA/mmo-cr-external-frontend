{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  <div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds">
    <div class="govuk-panel govuk-panel--confirmation"><h1 class="govuk-panel__title">{{ heading }}</h1></div>
    <h2 class="govuk-heading-m">What happens next</h2>
    {% if liveSkippers %}
    <p class="govuk-body">The skipper has been saved to this vessel. You can add or remove saved skippers from your account.</p>
    <p class="govuk-body">Saving a skipper does not send an invitation or give them access to the service.</p>
    {% else %}
    <p class="govuk-body">We’ve sent the skipper an email with instructions on how to access the service.</p>
    <p class="govuk-body">You can manage skipper access and add skippers for other vessels from your account.</p>
    {% endif %}
    {{ govukButton({ text: "Add another skipper", href: "/add-skipper" }) }}
    {{ govukButton({ text: "Go to account", href: "/account", classes: "govuk-button--secondary" }) }}
  </div></div>
{% endblock %}