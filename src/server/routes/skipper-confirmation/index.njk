{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  <div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds">
    <div class="govuk-panel govuk-panel--confirmation"><h1 class="govuk-panel__title">{{ heading }}</h1></div>
    <h2 class="govuk-heading-m">{{ t('common.whatHappensNext') }}</h2>
    {% if liveSkippers %}
    <p class="govuk-body">{{ t('skipperConfirmation.saved') }}</p>
    <p class="govuk-body">{{ t('skipperConfirmation.noInvitation') }}</p>
    {% else %}
    <p class="govuk-body">{{ t('skipperConfirmation.emailSent') }}</p>
    <p class="govuk-body">{{ t('skipperConfirmation.manageAccess') }}</p>
    {% endif %}
    {{ govukButton({ text: t('skipperConfirmation.button.addAnother'), href: "/add-skipper" }) }}
    {{ govukButton({ text: t('skipperConfirmation.button.goToAccount'), href: "/account", classes: "govuk-button--secondary" }) }}
  </div></div>
{% endblock %}