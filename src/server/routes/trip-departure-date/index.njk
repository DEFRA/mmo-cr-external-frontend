{% extends 'layouts/page.njk' %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="post" novalidate>
        {{ govukDateInput({
          id: "tripDepartureDate",
          namePrefix: "tripDepartureDate",
          fieldset: {
            legend: {
              html: '<span class="govuk-caption-l">' ~ caption ~ '</span>' ~ heading,
              isPageHeading: true,
              classes: "govuk-fieldset__legend--xl"
            }
          },
          hint: {
            text: hintText
          },
          errorMessage: { text: errorSummary.errorList[0].text } if errorSummary else false,
          items: [
            {
              name: "day",
              label: t("govuk.dateInput.day"),
              classes: "govuk-input--width-2" + (" govuk-input--error" if fieldErrors.day else ""),
              value: values.day
            },
            {
              name: "month",
              label: t("govuk.dateInput.month"),
              classes: "govuk-input--width-2" + (" govuk-input--error" if fieldErrors.month else ""),
              value: values.month
            },
            {
              name: "year",
              label: t("govuk.dateInput.year"),
              classes: "govuk-input--width-4" + (" govuk-input--error" if fieldErrors.year else ""),
              value: values.year
            }
          ]
        }) }}

        {{ govukButton({ text: t('common.button.saveAndContinue') }) }}
      </form>
    </div>
  </div>
{% endblock %}
