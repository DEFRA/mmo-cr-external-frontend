{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% block pageContent %}
  {{ appHeading({ text: heading }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="post" novalidate>
        {{ govukInput({
          label: { text: t('common.emailAddress') },
          id: "email",
          name: "email",
          type: "email",
          autocomplete: "username",
          value: email,
          errorMessage: { text: fieldErrors.email } if fieldErrors.email
        }) }}

        {{ govukInput({
          label: { text: t('signIn.password.label') },
          id: "password",
          name: "password",
          type: "password",
          autocomplete: "current-password",
          errorMessage: { text: fieldErrors.password } if fieldErrors.password
        }) }}

        {{ govukButton({ text: t('signIn.button') }) }}
      </form>

      <h2 class="govuk-heading-m">{{ t('signIn.trouble.heading') }}</h2>
      <p class="govuk-body">
        <a class="govuk-link" href="/forgotten-password">{{ t('forgottenPassword.title') }}</a>
      </p>
      {% call govukDetails({
        summaryText: t('signIn.link.createAccount'),
        open: true
      }) %}
        <p class="govuk-body">{{ t('signIn.createAccount.vesselOwner.heading') }}</p>
        <p class="govuk-body">{{ t('signIn.createAccount.vesselOwner.body') }}</p>
        <p class="govuk-body">{{ t('signIn.createAccount.skipper.heading') }}</p>
        <p class="govuk-body">{{ t('signIn.createAccount.skipper.body') }}</p>
      {% endcall %}
    </div>
  </div>
{% endblock %}
