{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% block pageContent %}
  {{ appHeading({ text: heading }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="post" novalidate>
        {{ govukInput({
          label: { text: "Email address" },
          id: "email",
          name: "email",
          type: "email",
          autocomplete: "username"
        }) }}

        {{ govukInput({
          label: { text: "Password" },
          id: "password",
          name: "password",
          type: "password",
          autocomplete: "current-password"
        }) }}

        {{ govukButton({ text: "Sign in" }) }}
      </form>

      <h2 class="govuk-heading-m">Having trouble signing in?</h2>
      <p class="govuk-body">
        <a class="govuk-link" href="/forgotten-password">Forgotten your password?</a>
      </p>
      {% call govukDetails({
        summaryText: "Create an account",
        open: true
      }) %}
        <p class="govuk-body">Vessel owner:</p>
        <p class="govuk-body">You will receive an email invitation to register when your vessel is added to the system.</p>
        <p class="govuk-body">Skipper or agent:</p>
        <p class="govuk-body">Ask your vessel owner to add you. They can do this from their account.</p>
      {% endcall %}
    </div>
  </div>
{% endblock %}
