{% extends 'layouts/page.njk' %}
{% from "placeholder-page/macro.njk" import appPlaceholderPage %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  {{ appPlaceholderPage({ heading: heading }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="post" novalidate>
        {{ govukButton({ text: "Continue" }) }}
      </form>

      <p class="govuk-body">
        <a class="govuk-link" href="/not-implemented?return=/sign-in">Forgotten your password?</a>
      </p>
      <p class="govuk-body">
        <a class="govuk-link" href="/not-implemented?return=/sign-in">Create an account</a>
      </p>
    </div>
  </div>
{% endblock %}
