{% extends 'layouts/page.njk' %}

{% block pageContent %}
  <div class="app-guidance">
    {{ appHeading({
      text: heading,
      caption: "Guidance"
    }) }}

    <div class="govuk-grid-row app-guidance-content-row">
      <div class="govuk-grid-column-two-thirds">
        <p class="govuk-body-l">
          A catch record includes details of the fish caught, including the
          species, weight, date and location of the catch. You must create a
          catch record for every fishing trip.
        </p>
      </div>
    </div>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full">
        <p class="govuk-body-s app-guidance-departments">
          From:
          <a class="govuk-link" href="https://www.gov.uk/government/organisations/department-for-environment-food-rural-affairs">Department for Environment, Food &amp; Rural Affairs</a>
          and
          <a class="govuk-link" href="https://www.gov.uk/government/organisations/marine-management-organisation">Marine Management Organisation</a>
        </p>
      </div>
    </div>

    <div class="govuk-grid-row app-guidance-content-row">
      <div class="govuk-grid-column-two-thirds">
        <div class="app-guidance-applies-to">Applies to England</div>

        <p class="govuk-body-s">Contents</p>
        <nav aria-label="Contents">
          <ul class="govuk-list app-guidance-contents">
            <li><a class="govuk-link" data-testid="app-guidance-contents-link" href="#what-we-need-from-you">What we need from you</a></li>
            <li><a class="govuk-link" data-testid="app-guidance-contents-link" href="#when-to-create-your-record">When to create your record</a></li>
            <li><a class="govuk-link" data-testid="app-guidance-contents-link" href="#special-cases-ices-areas">Special cases</a></li>
            <li><a class="govuk-link" data-testid="app-guidance-contents-link" href="#how-to-create-a-record">How to create a record</a></li>
            <li><a class="govuk-link" data-testid="app-guidance-contents-link" href="#get-help-with-your-record">Get help</a></li>
          </ul>
        </nav>

        <button class="app-guidance-print-button" data-module="app-print-button" data-testid="app-guidance-print-button" type="button">
          <svg class="app-guidance-print-button__icon" aria-hidden="true" focusable="false" viewBox="0 0 16 16">
            <path d="M4 5V1h8v4M4 12H2V6h12v6h-2M4 10h8v5H4z" fill="none" stroke="currentColor" stroke-width="1.5" />
            <path d="M11 8h1" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
          Print this page
        </button>

        {% include "partials/how-to-record-a-catch.njk" %}
      </div>
    </div>
  </div>
{% endblock %}
