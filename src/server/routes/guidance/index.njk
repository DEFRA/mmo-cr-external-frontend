{% extends 'layouts/page.njk' %}

{% block pageContent %}
  <div class="app-guidance">
    {{ appHeading({
      text: heading,
      caption: t('web.guidance.index.copy.7.1')
    }) }}

    <div class="govuk-grid-row app-guidance-content-row">
      <div class="govuk-grid-column-two-thirds">
        <p class="govuk-body-l">
          {{ t('guidance.copy.01') }}
        </p>
      </div>
    </div>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full">
        <p class="govuk-body-s app-guidance-departments">
          {{ t('guidance.copy.02') }}
          <a class="govuk-link" href="https://www.gov.uk/government/organisations/department-for-environment-food-rural-affairs">{{ t('guidance.copy.03') }}</a>
          {{ t('guidance.copy.04') }}
          <a class="govuk-link" href="https://www.gov.uk/government/organisations/marine-management-organisation">{{ t('guidance.copy.05') }}</a>
        </p>
      </div>
    </div>

    <div class="govuk-grid-row app-guidance-content-row">
      <div class="govuk-grid-column-two-thirds">
        <div class="app-guidance-applies-to">{{ t('guidance.copy.06') }}</div>

        <p class="govuk-body-s">{{ t('guidance.copy.07') }}</p>
        <nav aria-label="{{ t('guidance.copy.07') }}">
          <ul class="govuk-list app-guidance-contents">
            <li><a class="govuk-link" data-testid="app-guidance-contents-link" href="#what-we-need-from-you">{{ t('guidance.copy.08') }}</a></li>
            <li><a class="govuk-link" data-testid="app-guidance-contents-link" href="#when-to-create-your-record">{{ t('guidance.copy.09') }}</a></li>
            <li><a class="govuk-link" data-testid="app-guidance-contents-link" href="#special-cases-ices-areas">{{ t('guidance.copy.10') }}</a></li>
            <li><a class="govuk-link" data-testid="app-guidance-contents-link" href="#how-to-create-a-record">{{ t('guidance.copy.11') }}</a></li>
            <li><a class="govuk-link" data-testid="app-guidance-contents-link" href="#get-help-with-your-record">{{ t('guidance.copy.12') }}</a></li>
          </ul>
        </nav>

        <button class="app-guidance-print-button" data-module="app-print-button" data-testid="app-guidance-print-button" type="button">
          <svg class="app-guidance-print-button__icon" aria-hidden="true" focusable="false" viewBox="0 0 16 16">
            <path d="M4 5V1h8v4M4 12H2V6h12v6h-2M4 10h8v5H4z" fill="none" stroke="currentColor" stroke-width="1.5" />
            <path d="M11 8h1" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
          {{ t('guidance.copy.13') }}
        </button>

        {% include "partials/how-to-record-a-catch.njk" %}
      </div>
    </div>
  </div>
{% endblock %}
