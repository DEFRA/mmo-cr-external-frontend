{% extends 'layouts/page.njk' %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  <div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds">
    {% if skipperItems.length %}
      <form method="post" novalidate>
        {{ govukCheckboxes({
          name: "skipperIds",
          fieldset: { legend: { text: heading, isPageHeading: true, classes: "govuk-fieldset__legend--xl" } },
          errorMessage: { text: fieldErrors.skipperIds } if fieldErrors.skipperIds,
          items: skipperItems
        }) }}
        {{ govukButton({ text: "Remove selected skippers" }) }}
      </form>
    {% else %}
      <h1 class="govuk-heading-xl">{{ heading }}</h1>
      <p class="govuk-body">There are no saved skippers for this vessel.</p>
      <p class="govuk-body"><a class="govuk-link" href="/account">Return to account</a></p>
    {% endif %}
  </div></div>
{% endblock %}
