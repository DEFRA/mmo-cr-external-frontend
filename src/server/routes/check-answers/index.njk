{% extends 'layouts/page.njk' %}
{% from "catch-record-summary-sections/macro.njk" import appCatchRecordSummarySections %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl" data-testid="app-heading-title">{{ heading }}</h1>

      {{ appCatchRecordSummarySections(sections, gearGroups, trailingSections) }}

      <form method="post" novalidate>
        {{ govukButton({ text: "Save and continue" }) }}
      </form>
    </div>
  </div>
{% endblock %}
