{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/pagination/template.njk" import arrowPrevious, arrowNext %}
{% block pageContent %}
  <h1 class="govuk-heading-xl">{{ heading }}</h1>
  <form method="post" action="/records/new">
    {{ govukButton({ text: t('home.createRecord.button'), type: "submit" }) }}
  </form>
  {# Temporarily hide the record-status filter.
  <form method="get" action="/records">
    <label class="govuk-label" for="status">{{ t('web.live-records.list.copy.13.1') }}</label>
    <select class="govuk-select" id="status" name="status">
      <option value="">{{ t('web.live-records.list.copy.15.1') }}</option>
      {% for value, label in {DRAFT: "Draft", SUBMITTED: "Submitted", COMPLETE: "Complete"} %}
        <option value="{{ value }}" {% if statusFilter == value %}selected{% endif %}>{{ label }}</option>
      {% endfor %}
    </select>
    {{ govukButton({ text: t('web.live-records.list.copy.20.1'), classes: "govuk-button--secondary" }) }}
  </form>
  #}
  {% if bounded %}<p class="govuk-body">{{ t('web.live-records.list.copy.23.1') }}</p>{% endif %}
  {% if records.length %}
    <table class="govuk-table">
      <caption class="govuk-table__caption govuk-table__caption--m">{{ t('web.live-records.list.copy.26.1') }}</caption>
      <thead><tr>
        <th class="govuk-table__header" scope="col">{{ t('web.live-records.list.copy.28.1') }}</th>
        <th class="govuk-table__header" scope="col">{{ t('web.live-records.list.copy.29.1') }}</th>
        <th class="govuk-table__header" scope="col">{{ t('home.table.header.endDate') }}</th>
        <th class="govuk-table__header" scope="col">{{ t('home.table.header.status') }}</th>
      </tr></thead>
      <tbody>{% for record in records %}<tr>
        <td class="govuk-table__cell">{% if record.status == "DRAFT" %}<a class="govuk-link" href="/draft?recordId={{ record.id | urlencode }}">{{ record.catchRecordReference }}</a>{% elif recordDetailsEnabled %}<a class="govuk-link" href="/records/{{ record.id | urlencode }}">{{ record.catchRecordReference }}</a>{% else %}{{ record.catchRecordReference }}{% endif %}</td>
        <td class="govuk-table__cell">{{ record.vessel.nameSnapshot }}</td>
        <td class="govuk-table__cell">{% if recordDetailsEnabled and record.status == "SUBMITTED" %}<a class="govuk-link" href="/records/{{ record.id | urlencode }}">{{ record.trip.dateEnded | formatDate("d MMM yyyy") if record.trip.dateEnded else "Not entered" }}<span class="govuk-visually-hidden"> ({{ record.catchRecordReference }})</span></a>{% else %}{{ record.trip.dateEnded | formatDate("d MMM yyyy") if record.trip.dateEnded else "Not entered" }}{% endif %}</td>
        <td class="govuk-table__cell">{{ govukTag({
          text: record.displayStatus,
          classes: "app-records-status " + record.statusTagClasses
        }) }}</td>
      </tr>{% endfor %}</tbody>
    </table>
    <div class="app-records-pagination">
      <div class="app-records-pagination__summary">
        {% if pagination.hasPrevious %}
          <a class="govuk-link app-records-pagination__control" href="?page={{ pagination.currentPage - 1 }}&amp;status={{ statusFilter }}" rel="prev">
            {{ arrowPrevious | safe }}<span class="govuk-visually-hidden">{{ t('govuk.pagination.previousPage') }}</span>
          </a>
        {% else %}
          <span class="app-records-pagination__control app-records-pagination__control--disabled" aria-disabled="true">
            {{ arrowPrevious | safe }}<span class="govuk-visually-hidden">{{ t('govuk.pagination.previousPage') }}</span>
          </span>
        {% endif %}
        <p class="govuk-body govuk-!-font-weight-bold" data-testid="app-records-results">{{ t('records.pagination.showing', { first: pagination.firstItem, last: pagination.lastItem, total: pagination.total }) }}<span class="govuk-visually-hidden"> {{ t('web.live-records.list.copy.54.1') }}</span></p>
      </div>
      {{ govukPagination({ items: paginationItems }) }}
      {% if pagination.hasNext %}
        <a class="govuk-link app-records-pagination__control app-records-pagination__next" href="?page={{ pagination.currentPage + 1 }}&amp;status={{ statusFilter }}" rel="next"><span class="app-records-pagination__label">{{ t('govuk.pagination.next') }}</span>{{ arrowNext | safe }}</a>
      {% else %}
        <span class="app-records-pagination__control app-records-pagination__control--disabled app-records-pagination__next" aria-disabled="true"><span class="app-records-pagination__label">{{ t('govuk.pagination.next') }}</span>{{ arrowNext | safe }}</span>
      {% endif %}
    </div>
  {% else %}<p class="govuk-body">{{ t('web.live-records.list.copy.63.1') }}</p>{% endif %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% include "partials/catch-record-help.njk" %}
    </div>
  </div>
{% endblock %}
