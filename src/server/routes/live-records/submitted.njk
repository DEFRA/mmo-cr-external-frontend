{% extends 'layouts/page.njk' %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">{{ record.catchRecordReference }}</span>
      <h1 class="govuk-heading-xl">{{ t('liveRecords.recordFor', { vesselName: record.vessel.nameSnapshot }) }}</h1>
      {% for section in sections %}
        {% if section.startsGearSection %}
          <h2 class="govuk-heading-l">{{ t('web.live-records.submitted.copy.12.1') }}</h2>
        {% endif %}
        {% if section.startsSpeciesSection %}
          <h2 class="govuk-heading-l">{{ t('web.live-records.submitted.copy.15.1') }}</h2>
        {% endif %}
        <section aria-labelledby="submitted-summary-{{ loop.index }}"{% if section.gearId %} data-gear-id="{{ section.gearId }}" data-summary-section="{{ section.kind }}"{% endif %}>
          {% if section.kind == "gear" %}
            <h3 id="submitted-summary-{{ loop.index }}" class="govuk-heading-m">{{ section.gearName }}</h3>
          {% elif section.kind == "species" %}
            <h3 id="submitted-summary-{{ loop.index }}" class="govuk-heading-m">{{ section.speciesName }}</h3>
          {% else %}
            <h2 id="submitted-summary-{{ loop.index }}" class="govuk-heading-l">{{ section.heading }}</h2>
          {% endif %}
          {% if section.kind == "species" and section.gearName %}
            <p class="govuk-body">{{ t('summary.caughtWith', { gear: section.gearName }) }}</p>
          {% endif %}
          {{ govukSummaryList({ rows: section.rows }) }}
        </section>
      {% endfor %}
      <div class="govuk-button-group">
        {{ govukButton({ text: t('web.live-records.submitted.copy.32.1'), href: recordPath + "/edit-reason" }) }}
        {% if latestPdf %}
          {{ govukButton({
            text: t('web.live-records.submitted.copy.35.1'),
            href: recordPath + "/submissions/" + latestPdf.submissionNumber + "/pdf",
            classes: "govuk-button--secondary"
          }) }}
        {% endif %}
      </div>
      {% if completionEnabled %}
        <h2 class="govuk-heading-l">{{ t('web.live-records.submitted.copy.42.1') }}</h2>
        <p class="govuk-body">{{ t('web.live-records.submitted.copy.43.1') }}</p>
        <form method="post" action="{{ recordPath }}/complete">
          <input type="hidden" name="actionKey" value="{{ actionKey }}">
          {{ govukButton({ text: t('web.live-records.submitted.copy.46.1'), classes: "govuk-button--secondary" }) }}
        </form>
      {% endif %}
    </div>
  </div>
{% endblock %}
