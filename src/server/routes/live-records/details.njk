{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% block pageContent %}
  <span class="govuk-caption-l">{{ record.catchRecordReference }}</span>
  <h1 class="govuk-heading-xl">{{ t('liveRecords.recordFor', { vesselName: record.vessel.nameSnapshot }) }}</h1>
  <p class="govuk-body">{{ t('web.live-records.details.copy.6.1') }} <strong>{{ record.displayStatus }}</strong></p>
  <h2 class="govuk-heading-l">{{ t('catchRecord.checkYourAnswers.section.trip') }}</h2>
  <dl class="govuk-summary-list">
    {% for label, value in {
      "Departure date": record.trip.dateStarted,
      "Return date": record.trip.dateEnded,
      "Departure port": record.trip.departurePort.nameSnapshot,
      "Return port": record.trip.returnPort.nameSnapshot
    } %}
      <div class="govuk-summary-list__row"><dt class="govuk-summary-list__key">{{ label }}</dt><dd class="govuk-summary-list__value">{{ value or t('common.notEntered') }}</dd></div>
    {% endfor %}
  </dl>
  <h2 class="govuk-heading-l">{{ t('web.live-records.details.copy.18.1') }}</h2>
  <p class="govuk-body">{{ t('summary.yes') if record.pairFishing.enabled else t('summary.no') }}</p>
  {% if record.pairFishing.enabled %}
    <p class="govuk-body">{{ t('liveRecords.pairedVessel', { vessel: record.pairFishing.pairVessel or t('common.notEntered') }) }}</p>
    <p class="govuk-body">{{ t('liveRecords.pairedSkipper', { skipper: record.pairFishing.pairSkipperName or t('common.notEntered') }) }}</p>
  {% endif %}
  <h2 class="govuk-heading-l">{{ t('web.live-records.details.copy.24.1') }}</h2>
  <ul class="govuk-list">
    {% for section, label in {trip: t('catchRecord.checkYourAnswers.section.trip'), pairFishing: t('summary.pairFishing'), gears: t('summary.gear')} %}
      <li>{{ label }}: {{ t('liveRecords.status.complete') if record.sectionCompletion[section] else t('liveRecords.status.notComplete') }}</li>
    {% endfor %}
  </ul>
  <p class="govuk-body">{{ t('liveRecords.preliminaryChecksPassed') if record.submissionEligible else t('liveRecords.notReadyToSubmit') }}</p>
  <h2 class="govuk-heading-l">{{ t('web.live-records.details.copy.31.1') }}</h2>
  {% for entry in record.gears %}
    <h3 class="govuk-heading-m">{{ entry.gear.nameSnapshot }}</h3>
    <p class="govuk-body">{{ t('liveRecords.statisticalArea', { area: entry.statisticalArea.codeSnapshot or t('common.notEntered') }) }}</p>
    <ul class="govuk-list">
      {% for characteristic in entry.characteristics %}<li>{{ characteristic.nameSnapshot }}: {{ characteristic.value }} {{ characteristic.unitSnapshot }}</li>{% endfor %}
      {% for species in entry.speciesCaught %}
        <li>{{ t('liveRecords.speciesWeightLine', {
          name: species.nameSnapshot,
          code: species.faoCodeSnapshot,
          above: species.weightAboveMinimumKg if species.weightAboveMinimumKg != null else t('common.notEntered'),
          below: species.weightBelowMinimumKg if species.weightBelowMinimumKg != null else t('common.notEntered'),
          discarded: species.weightLegallyDiscardedKg if species.weightLegallyDiscardedKg != null else t('common.notEntered')
        }) }}</li>
      {% endfor %}
    </ul>
  {% else %}<p class="govuk-body">{{ t('web.live-records.details.copy.45.1') }}</p>{% endfor %}
  <h2 class="govuk-heading-l">{{ t('catchRecord.checkYourAnswers.section.speciesNotLanded') }}</h2>
  <ul class="govuk-list">{% for species in record.speciesNotLanded %}
    <li>{{ t('liveRecords.speciesWeightLine', {
      name: species.nameSnapshot,
      code: species.faoCodeSnapshot,
      above: species.weightAboveMinimumKg if species.weightAboveMinimumKg != null else t('common.notEntered'),
      below: species.weightBelowMinimumKg if species.weightBelowMinimumKg != null else t('common.notEntered'),
      discarded: species.weightLegallyDiscardedKg if species.weightLegallyDiscardedKg != null else t('common.notEntered')
    }) }}</li>
  {% else %}<li>{{ t('web.live-records.details.copy.53.1') }}</li>{% endfor %}</ul>
  <a class="govuk-link" href="{{ recordPath }}/history">{{ t('web.live-records.details.copy.54.1') }}</a>
  <h2 class="govuk-heading-l">{{ t('web.live-records.details.copy.55.1') }}</h2>
  <ul class="govuk-list">{% for submission in submissions %}
    <li>{{ t('liveRecords.submissionLabel', { number: submission.submissionNumber }) }}
      {% for artifact in submission.artifacts %}
        <a class="govuk-link govuk-!-margin-right-4" href="{{ recordPath }}/submissions/{{ submission.submissionNumber }}/{{ artifact.type }}">{{ t('liveRecords.downloadArtifact', { type: artifact.type | upper, number: submission.submissionNumber }) }}</a>
      {% endfor %}
    </li>
  {% else %}<li>{{ t('web.live-records.details.copy.62.1') }}</li>{% endfor %}</ul>
  {% if record.status == "DRAFT" %}
    <form method="post" action="{{ recordPath }}/resume">
      <input type="hidden" name="actionKey" value="{{ actionKey }}">
      {{ govukButton({text: t('web.live-records.details.copy.66.1')}) }}
    </form>
    {% if record.numberOfSubmissions == 0 %}
      <form method="post" action="{{ recordPath }}/delete">
        <input type="hidden" name="actionKey" value="{{ actionKey }}">
        {{ govukButton({text: t('web.live-records.details.copy.71.1'), classes: "govuk-button--warning"}) }}
      </form>
    {% endif %}
  {% else %}
    <form method="post" action="{{ recordPath }}/edit">
      <input type="hidden" name="actionKey" value="{{ actionKey }}">
      {{ govukButton({text: t('web.live-records.details.copy.77.1')}) }}
    </form>
  {% endif %}
  {% if completionEnabled and record.status == "SUBMITTED" %}
    <h2 class="govuk-heading-l">{{ t('web.live-records.details.copy.81.1') }}</h2>
    <p class="govuk-body">{{ t('web.live-records.details.copy.82.1') }}</p>
    <form method="post" action="{{ recordPath }}/complete">
      <input type="hidden" name="actionKey" value="{{ actionKey }}">
      {{ govukButton({text: t('web.live-records.details.copy.85.1'), classes: "govuk-button--secondary"}) }}
    </form>
  {% endif %}
{% endblock %}
