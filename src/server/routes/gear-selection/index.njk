{% extends 'layouts/page.njk' %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  {% set potsFieldsHtml %}
    {{ govukInput({
      id: "potsHauled",
      name: "potsHauled",
      label: { text: t('web.gear-selection.index.copy.10.1') },
      classes: "govuk-input--width-10",
      inputmode: "numeric",
      value: potsDetails.potsHauled,
      errorMessage: { text: fieldErrors.potsHauled } if fieldErrors.potsHauled else false
    }) }}
    {{ govukInput({
      id: "potsInWater",
      name: "potsInWater",
      label: { text: t('web.gear-selection.index.copy.19.1') },
      classes: "govuk-input--width-10",
      inputmode: "numeric",
      value: potsDetails.potsInWater,
      errorMessage: { text: fieldErrors.potsInWater } if fieldErrors.potsInWater else false
    }) }}
  {% endset %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="post" novalidate>
        {% if gearCheckboxItems.length %}
          <div class="govuk-form-group{{ ' govuk-form-group--error' if fieldErrors.gearIds }}">
            <fieldset class="govuk-fieldset" aria-describedby="gearIds-hint{{ ' gearIds-error' if fieldErrors.gearIds }}">
              <legend class="govuk-fieldset__legend govuk-fieldset__legend--xl">
                <h1 class="govuk-fieldset__heading"><span class="govuk-caption-l">{{ caption }}</span>{{ heading }}</h1>
              </legend>
              <div id="gearIds-hint" class="govuk-hint">{{ t('common.hint.selectAllThatApply') }}</div>
              {% if fieldErrors.gearIds %}
                <p id="gearIds-error" class="govuk-error-message">
                  <span class="govuk-visually-hidden">{{ t('a11y.errorPrefix') }}</span> {{ fieldErrors.gearIds }}
                </p>
              {% endif %}
              <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                {% for item in gearCheckboxItems %}
                  <div class="govuk-checkboxes__item">
                    <input
                      class="govuk-checkboxes__input"
                      id="gearIds-{{ loop.index }}"
                      name="gearIds"
                      type="checkbox"
                      value="{{ item.value }}"
                      {{ 'checked' if item.checked }}
                      {% if item.hint %}aria-describedby="gearIds-{{ loop.index }}-item-hint"{% endif %}
                      {% if item.value == 'pots' or item.measurements.length %}data-aria-controls="gearIds-conditional-{{ loop.index }}"{% endif %}
                    >
                    <label class="govuk-label govuk-checkboxes__label" for="gearIds-{{ loop.index }}">{{ item.text }}</label>
                    {% if item.hint %}
                      <div id="gearIds-{{ loop.index }}-item-hint" class="govuk-hint govuk-checkboxes__hint">{{ item.hint }}</div>
                    {% endif %}
                  </div>
                  {% if item.value == 'pots' %}
                    <div class="govuk-checkboxes__conditional{{ '' if item.checked else ' govuk-checkboxes__conditional--hidden' }}" id="gearIds-conditional-{{ loop.index }}">
                      {{ potsFieldsHtml | safe }}
                    </div>
                  {% elif item.measurements.length %}
                    <div class="govuk-checkboxes__conditional{{ '' if item.checked else ' govuk-checkboxes__conditional--hidden' }}" id="gearIds-conditional-{{ loop.index }}">
                      {% for measurement in item.measurements %}
                        {{ govukInput({
                          id: measurement.id,
                          name: measurement.id,
                          label: { text: measurement.label },
                          classes: "govuk-input--width-10",
                          inputmode: "numeric",
                          value: measurement.value,
                          errorMessage: { text: fieldErrors[measurement.id] } if fieldErrors[measurement.id] else false
                        }) }}
                      {% endfor %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </fieldset>
          </div>
        {% else %}
          {% if fieldErrors.gearIds %}
            <div class="govuk-form-group govuk-form-group--error">
              <span class="govuk-caption-l">{{ caption }}</span>
              <h1 class="govuk-heading-xl">{{ heading }}</h1>
              <p id="gearIds-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">{{ t('a11y.errorPrefix') }}</span> {{ fieldErrors.gearIds }}
              </p>
              <p class="govuk-body">{{ t('web.gear-selection.index.copy.91.1') }}</p>
            </div>
          {% else %}
            <span class="govuk-caption-l">{{ caption }}</span>
            <h1 class="govuk-heading-xl">{{ heading }}</h1>
            <p class="govuk-body">{{ t('web.gear-selection.index.copy.96.1') }}</p>
          {% endif %}
        {% endif %}

        <p class="govuk-body"><a class="govuk-link" href="/add-gear">{{ t('account.row.gearOnboard.add') }}</a></p>
        {% if gearCheckboxItems.length %}
          <p class="govuk-body"><a class="govuk-link" href="/remove-gear">{{ t('account.row.gearOnboard.remove') }}</a></p>
        {% endif %}

        {{ govukButton({ text: t('common.button.saveAndContinue'), classes: "govuk-!-margin-top-6" }) }}
      </form>
    </div>
  </div>
{% endblock %}
