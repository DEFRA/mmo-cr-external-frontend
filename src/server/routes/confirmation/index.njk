{% extends 'layouts/page.njk' %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukPanel({
        titleText: heading,
        html: t('confirmation.reference') + '<br><strong>' + reference + '</strong>'
      }) }}

      <h2 class="govuk-heading-m">{{ t('common.whatHappensNext') }}</h2>
      <ul class="govuk-list govuk-list--bullet">
        <li>{{ t('catchRecord.submissionSuccess.bullet.received') }}</li>
        <li>{{ t('catchRecord.submissionSuccess.bullet.email') }}</li>
        <li>{{ t('catchRecord.submissionSuccess.bullet.view') }}</li>
        <li>{{ t('catchRecord.submissionSuccess.bullet.save') }}</li>
      </ul>

      {{ govukButton({ text: t('web.confirmation.index.copy.21.1'), href: "/records" }) }}
    </div>
  </div>
{% endblock %}
