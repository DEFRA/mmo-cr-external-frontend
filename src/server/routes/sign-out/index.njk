{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl govuk-!-margin-bottom-8">{{ heading }}</h1>

      <p class="govuk-body">This is a new service &ndash; your <a class="govuk-link" href="{{ feedbackUrl }}">feedback</a> will help us to improve it.</p>

      {{ govukButton({ text: "Sign in", href: "/sign-in" }) }}
    </div>
  </div>
{% endblock %}