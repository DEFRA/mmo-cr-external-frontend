{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl govuk-!-margin-bottom-8">{{ heading }}</h1>

      {% set feedbackLink %}<a class="govuk-link" href="{{ feedbackUrl }}">{{ t('layout.phaseBanner.feedbackLink') }}</a>{% endset %}
      <p class="govuk-body">{{ tHtml('layout.phaseBanner.text', { feedbackLink: feedbackLink | safe }) }}</p>

      {{ govukButton({ text: t('signIn.button'), href: "/sign-in" }) }}
    </div>
  </div>
{% endblock %}