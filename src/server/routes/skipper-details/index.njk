{% extends 'layouts/page.njk' %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  <div class="govuk-grid-row"><div class="govuk-grid-column-two-thirds">
    <form method="post" novalidate>
      <h1 class="govuk-heading-xl">{{ heading }}</h1>
      {{ govukInput({ id: "firstName", name: "firstName", label: { text: t('skipper.firstName.label') }, value: values.firstName, attributes: { "data-clear-input-error": "true" }, errorMessage: { text: fieldErrors.firstName } if fieldErrors.firstName }) }}
      {{ govukInput({ id: "lastName", name: "lastName", label: { text: t('skipper.lastName.label') }, value: values.lastName, attributes: { "data-clear-input-error": "true" }, errorMessage: { text: fieldErrors.lastName } if fieldErrors.lastName }) }}
      {{ govukInput({ id: "email", name: "email", type: "email", label: { text: t('skipper.email.labelOptional') if liveSkippers else t('common.emailAddress') }, hint: { text: t('skipperDetails.email.hintContactOnly') if liveSkippers else t('skipperDetails.email.hint') }, value: values.email, attributes: { "data-clear-input-error": "true" }, errorMessage: { text: fieldErrors.email } if fieldErrors.email }) }}
      {% if liveSkippers %}
        {{ govukInput({ id: "phoneNumber", name: "phoneNumber", type: "tel", label: { text: t('skipper.phoneNumber.labelOptional') }, value: values.phoneNumber, errorMessage: { text: fieldErrors.phoneNumber } if fieldErrors.phoneNumber }) }}
      {% endif %}
      {{ govukButton({ text: t('common.button.saveAndContinue') }) }}
    </form>
  </div></div>
{% endblock %}