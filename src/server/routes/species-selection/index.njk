{% extends 'layouts/page.njk' %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="post" novalidate>
        <div class="govuk-form-group{{ ' govuk-form-group--error' if fieldErrors.speciesIds }}">
          <fieldset class="govuk-fieldset">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
              <h1 class="govuk-fieldset__heading">
                <span class="govuk-caption-l">{{ caption }}</span>
                {{ heading }}
              </h1>
            </legend>
            <p class="govuk-body">
              {{ t('web.species-selection.index.copy.17.1') }}
              <a class="govuk-link" href="/guidance">{{ t('web.species-selection.index.copy.21.1') }}</a>
            </p>
            {% if fieldErrors.speciesIds %}
              <p id="speciesIds-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">{{ t('a11y.errorPrefix') }}</span> {{ fieldErrors.speciesIds }}
              </p>
            {% endif %}
            <div class="govuk-checkboxes app-species-checkboxes" data-module="govuk-checkboxes">
              {% for item in speciesCheckboxItems %}
                <div class="govuk-checkboxes__item">
                  <input
                    class="govuk-checkboxes__input"
                    id="speciesIds-{{ loop.index }}"
                    name="speciesIds"
                    type="checkbox"
                    value="{{ item.value }}"
                    {{ 'checked' if item.checked }}
                    data-aria-controls="speciesIds-conditional-{{ loop.index }}"
                  >
                  <label class="govuk-label govuk-checkboxes__label" for="speciesIds-{{ loop.index }}">{{ item.text }}</label>
                </div>
                <div class="govuk-checkboxes__conditional{{ '' if item.checked else ' govuk-checkboxes__conditional--hidden' }}" id="speciesIds-conditional-{{ loop.index }}">
                  {{ govukInput({
                    id: "weightAboveMinimum-" + item.value,
                    name: "weightAboveMinimum-" + item.value,
                    label: { text: t('catchRecord.species.weight.above') },
                    classes: "govuk-!-width-one-half",
                    inputmode: "decimal",
                    value: item.weights.weightAboveMinimum,
                    errorMessage: { text: item.fieldErrors.weightAboveMinimum } if item.fieldErrors.weightAboveMinimum else false
                  }) }}

                  <div class="{{ '' if item.weightFieldsVisible.belowMinimum else 'govuk-visually-hidden' }}" id="weightBelowMinimum-{{ item.value }}-group">
                    {{ govukInput({
                      id: "weightBelowMinimum-" + item.value,
                      name: "weightBelowMinimum-" + item.value,
                      label: { text: t('catchRecord.species.weight.below') },
                      classes: "govuk-!-width-one-half",
                      inputmode: "decimal",
                      value: item.weights.weightBelowMinimum,
                      errorMessage: { text: item.fieldErrors.weightBelowMinimum } if item.fieldErrors.weightBelowMinimum else false
                    }) }}
                  </div>
                  <p class="govuk-body app-weight-toggle">
                    <a href="#" class="govuk-link js-weight-toggle" data-target="weightBelowMinimum-{{ item.value }}-group" data-add-text="{{ t('speciesSelection.weightToggle.addBelow') }}" data-remove-text="{{ t('speciesSelection.weightToggle.removeBelow') }}">                                        {{- t('speciesSelection.weightToggle.removeBelow') if item.weightFieldsVisible.belowMinimum else t('speciesSelection.weightToggle.addBelow') -}}</a>
                  </p>

                  <div class="{{ '' if item.weightFieldsVisible.legallyDiscarded else 'govuk-visually-hidden' }}" id="weightDiscarded-{{ item.value }}-group">
                    {{ govukInput({
                      id: "weightDiscarded-" + item.value,
                      name: "weightDiscarded-" + item.value,
                      label: { text: t('catchRecord.species.weight.discarded') },
                      classes: "govuk-!-width-one-half",
                      inputmode: "decimal",
                      value: item.weights.weightDiscarded,
                      errorMessage: { text: item.fieldErrors.weightDiscarded } if item.fieldErrors.weightDiscarded else false
                    }) }}
                  </div>
                  <p class="govuk-body app-weight-toggle">
                    <a href="#" class="govuk-link js-weight-toggle" data-target="weightDiscarded-{{ item.value }}-group" data-add-text="{{ t('speciesSelection.weightToggle.addDiscarded') }}" data-remove-text="{{ t('speciesSelection.weightToggle.removeDiscarded') }}">                                        {{- t('speciesSelection.weightToggle.removeDiscarded') if item.weightFieldsVisible.legallyDiscarded else t('speciesSelection.weightToggle.addDiscarded') -}}</a>
                  </p>
                </div>
              {% endfor %}
            </div>
          </fieldset>
        </div>

        <p class="govuk-body"><a class="govuk-link" href="{{ addSpeciesHref }}">{{ t('account.row.speciesCaught.add') }}</a></p>
        {% if speciesCheckboxItems.length %}
          <p class="govuk-body"><a class="govuk-link" href="{{ removeSpeciesHref }}">{{ t('account.row.speciesCaught.remove') }}</a></p>
        {% endif %}

        {{ govukButton({
          text: t('common.button.saveAndContinue'),
          name: "speciesAction",
          value: "continue",
          classes: "govuk-!-margin-top-6"
        }) }}
      </form>
    </div>
  </div>
{% endblock %}
