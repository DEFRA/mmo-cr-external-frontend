{% extends 'layouts/page.njk' %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="post" novalidate>
        <div class="govuk-form-group{{ ' govuk-form-group--error' if fieldErrors.speciesIds }}">
          <fieldset class="govuk-fieldset">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
              <h1 class="govuk-fieldset__heading">
                <span class="govuk-caption-l">{{ caption }}</span>
                {{ heading }}
              </h1>
            </legend>
            <p class="govuk-body">
              Select all the species you caught, with or without catch limits.
              Then enter estimated live weights. Landed weights can be
              converted to live weights by multiplying them by a
              <a class="govuk-link" href="/guidance">conversion factor</a>
            </p>
            {% if fieldErrors.speciesIds %}
              <p id="speciesIds-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">Error:</span> {{ fieldErrors.speciesIds }}
              </p>
            {% endif %}
            <div class="govuk-checkboxes app-species-checkboxes" data-module="govuk-checkboxes">
              {% for item in speciesCheckboxItems %}
                <div class="govuk-checkboxes__item">
                  <input
                    class="govuk-checkboxes__input"
                    id="speciesIds-{{ loop.index }}"
                    name="speciesIds"
                    type="checkbox"
                    value="{{ item.value }}"
                    {{ 'checked' if item.checked }}
                    data-aria-controls="speciesIds-conditional-{{ loop.index }}"
                  >
                  <label class="govuk-label govuk-checkboxes__label" for="speciesIds-{{ loop.index }}">{{ item.text }}</label>
                </div>
                <div class="govuk-checkboxes__conditional{{ '' if item.checked else ' govuk-checkboxes__conditional--hidden' }}" id="speciesIds-conditional-{{ loop.index }}">
                  {{ govukInput({
                    id: "weightAboveMinimum-" + item.value,
                    name: "weightAboveMinimum-" + item.value,
                    label: { text: "Weight above minimum size retained (kg)" },
                    classes: "govuk-!-width-one-half",
                    inputmode: "decimal",
                    value: item.weights.weightAboveMinimum,
                    errorMessage: { text: item.fieldErrors.weightAboveMinimum } if item.fieldErrors.weightAboveMinimum else false
                  }) }}

                  <p class="govuk-body app-weight-toggle">
                    <a href="#" class="govuk-link js-weight-toggle" data-target="weightBelowMinimum-{{ item.value }}-group" data-add-text="Add weight below minimum size retained (kg)" data-remove-text="Remove weight below minimum size retained (kg)">{{ 'Remove' if item.weightFieldsVisible.belowMinimum else 'Add' }} weight below minimum size retained (kg)</a>
                  </p>
                  <div class="{{ '' if item.weightFieldsVisible.belowMinimum else 'govuk-visually-hidden' }}" id="weightBelowMinimum-{{ item.value }}-group">
                    {{ govukInput({
                      id: "weightBelowMinimum-" + item.value,
                      name: "weightBelowMinimum-" + item.value,
                      label: { text: "Weight below minimum size retained (kg)" },
                      classes: "govuk-!-width-one-half",
                      inputmode: "decimal",
                      value: item.weights.weightBelowMinimum,
                      errorMessage: { text: item.fieldErrors.weightBelowMinimum } if item.fieldErrors.weightBelowMinimum else false
                    }) }}
                  </div>

                  <p class="govuk-body app-weight-toggle">
                    <a href="#" class="govuk-link js-weight-toggle" data-target="weightDiscarded-{{ item.value }}-group" data-add-text="Add weight legally discarded (kg)" data-remove-text="Remove weight legally discarded (kg)">{{ 'Remove' if item.weightFieldsVisible.legallyDiscarded else 'Add' }} weight legally discarded (kg)</a>
                  </p>
                  <div class="{{ '' if item.weightFieldsVisible.legallyDiscarded else 'govuk-visually-hidden' }}" id="weightDiscarded-{{ item.value }}-group">
                    {{ govukInput({
                      id: "weightDiscarded-" + item.value,
                      name: "weightDiscarded-" + item.value,
                      label: { text: "Weight legally discarded (kg)" },
                      classes: "govuk-!-width-one-half",
                      inputmode: "decimal",
                      value: item.weights.weightDiscarded,
                      errorMessage: { text: item.fieldErrors.weightDiscarded } if item.fieldErrors.weightDiscarded else false
                    }) }}
                  </div>
                </div>
              {% endfor %}
            </div>
          </fieldset>
        </div>

        <p class="govuk-body"><a class="govuk-link" href="/add-species?return=/species-selection">Add species</a></p>
        <p class="govuk-body"><a class="govuk-link" href="/remove-species?return=/species-selection">Remove species</a></p>

        {{ govukButton({
          text: "Save and continue",
          name: "speciesAction",
          value: "continue",
          classes: "govuk-!-margin-top-6"
        }) }}
      </form>
    </div>
  </div>
{% endblock %}

