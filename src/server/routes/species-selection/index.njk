{% extends 'layouts/page.njk' %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  {% set codWeightFieldsHtml %}
    {{ govukInput({
      id: "weightAboveMinimum",
      name: "weightAboveMinimum",
      label: { text: "Weight above minimum size retained (kg)" },
      classes: "govuk-input--width-5",
      inputmode: "decimal",
      value: weights.weightAboveMinimum,
      errorMessage: { text: fieldErrors.weightAboveMinimum } if fieldErrors.weightAboveMinimum else false
    }) }}

    {% if weightFieldsVisible.belowMinimum %}
      <input type="hidden" name="belowMinimumVisible" value="true">
      {{ govukInput({
        id: "weightBelowMinimum",
        name: "weightBelowMinimum",
        label: { text: "Weight below minimum size retained (kg)" },
        classes: "govuk-input--width-5",
        inputmode: "decimal",
        value: weights.weightBelowMinimum,
        errorMessage: { text: fieldErrors.weightBelowMinimum } if fieldErrors.weightBelowMinimum else false
      }) }}
      {{ govukButton({
        text: "Remove weight below minimum size retained (kg)",
        name: "speciesAction",
        value: "remove-below-minimum",
        classes: "govuk-button--secondary"
      }) }}
    {% else %}
      {{ govukButton({
        text: "Add weight below minimum size retained (kg)",
        name: "speciesAction",
        value: "add-below-minimum",
        classes: "govuk-button--secondary"
      }) }}
    {% endif %}

    {% if weightFieldsVisible.legallyDiscarded %}
      <input type="hidden" name="legallyDiscardedVisible" value="true">
      {{ govukInput({
        id: "weightDiscarded",
        name: "weightDiscarded",
        label: { text: "Weight legally discarded (kg)" },
        classes: "govuk-input--width-5",
        inputmode: "decimal",
        value: weights.weightDiscarded,
        errorMessage: { text: fieldErrors.weightDiscarded } if fieldErrors.weightDiscarded else false
      }) }}
      {{ govukButton({
        text: "Remove weight legally discarded (kg)",
        name: "speciesAction",
        value: "remove-legally-discarded",
        classes: "govuk-button--secondary"
      }) }}
    {% else %}
      {{ govukButton({
        text: "Add weight legally discarded (kg)",
        name: "speciesAction",
        value: "add-legally-discarded",
        classes: "govuk-button--secondary"
      }) }}
    {% endif %}
  {% endset %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="post" novalidate>
        <div class="govuk-form-group{{ ' govuk-form-group--error' if fieldErrors.speciesIds }}">
          <fieldset class="govuk-fieldset">
            <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
              <h1 class="govuk-fieldset__heading">
                <span class="govuk-caption-l">{{ caption }}</span>
                {{ heading }}
              </h1>
            </legend>
            {% if fieldErrors.speciesIds %}
              <p id="speciesIds-error" class="govuk-error-message">
                <span class="govuk-visually-hidden">Error:</span> {{ fieldErrors.speciesIds }}
              </p>
            {% endif %}
            <div class="govuk-checkboxes" data-module="govuk-checkboxes">
              {% for item in speciesCheckboxItems %}
                <div class="govuk-checkboxes__item">
                  <input
                    class="govuk-checkboxes__input"
                    id="speciesIds-{{ loop.index }}"
                    name="speciesIds"
                    type="checkbox"
                    value="{{ item.value }}"
                    {{ 'checked' if item.checked }}
                    {% if item.value == 'cod' %}data-aria-controls="speciesIds-conditional-{{ loop.index }}"{% endif %}
                  >
                  <label class="govuk-label govuk-checkboxes__label" for="speciesIds-{{ loop.index }}">{{ item.text }}</label>
                </div>
                {% if item.value == 'cod' %}
                  <div class="govuk-checkboxes__conditional{{ '' if codSelected else ' govuk-checkboxes__conditional--hidden' }}" id="speciesIds-conditional-{{ loop.index }}">
                    {{ codWeightFieldsHtml | safe }}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </fieldset>
        </div>

        <p class="govuk-body"><a class="govuk-link" href="/not-implemented?return=/species-selection">Add species</a></p>
        <p class="govuk-body"><a class="govuk-link" href="/not-implemented?return=/species-selection">Remove species</a></p>

        {{ govukButton({
          text: "Save and continue",
          name: "speciesAction",
          value: "continue",
          classes: "govuk-!-margin-top-6"
        }) }}
      </form>
    </div>
  </div>
{% endblock %}

