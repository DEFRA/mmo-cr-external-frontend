{% extends 'layouts/page.njk' %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "catch-record-summary-sections/macro.njk" import appCatchRecordSummarySections %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l" data-testid="app-record-reference">{{ details.reference }}</span>
      <h1 class="govuk-heading-xl" data-testid="app-heading-title">{{ heading }}</h1>

      {% if status %}
        <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">{{ t('web.record-details.index.copy.13.1') }}</p>
        <strong class="govuk-tag govuk-tag--grey">{{ status | capitalize }}</strong>
      {% endif %}

      {% if sections or gearGroups %}
        {{ appCatchRecordSummarySections(sections, gearGroups, trailingSections, readOnly) }}
      {% else %}
      <h2 class="govuk-heading-l">{{ t('web.record-details.index.copy.20.1') }}</h2>
      {{ govukSummaryList({ rows: [
        { key: { text: t('web.record-details.index.copy.22.1') }, value: { text: details.vesselName } },
        { key: { text: t('catchRecord.checkYourAnswers.label.departureDate') }, value: { text: details.departureDate | formatDate("d MMMM yyyy") } },
        { key: { text: t('catchRecord.checkYourAnswers.label.returnDate') }, value: { text: details.returnDate | formatDate("d MMMM yyyy") } },
        { key: { text: t('catchRecord.checkYourAnswers.label.departurePort') }, value: { text: details.departurePort } },
        { key: { text: t('catchRecord.checkYourAnswers.label.returnPort') }, value: { text: details.returnPort } },
        { key: { text: t('web.record-details.index.copy.27.1') }, value: { text: details.statisticalSubArea } }
      ] }) }}

      <h2 class="govuk-heading-l">{{ t('web.record-details.index.copy.30.1') }}</h2>
      {{ govukSummaryList({ rows: [
        { key: { text: t('web.record-details.index.copy.32.1') }, value: { text: details.gear } },
        { key: { text: t('web.record-details.index.copy.33.1') }, value: { text: details.potsHauled } },
        { key: { text: t('web.record-details.index.copy.34.1') }, value: { text: details.potsInWater } }
      ] }) }}

      <h2 class="govuk-heading-l">{{ t('account.row.speciesCaught.key') }}</h2>
      {{ govukSummaryList({ rows: [
        { key: { text: t('catchRecord.checkYourAnswers.label.speciesName') }, value: { text: details.species } },
        { key: { text: t('catchRecord.checkYourAnswers.label.weightAbove') }, value: { text: details.weightAboveMinimumRetained ~ " " ~ details.weightUnit } },
        { key: { text: t('catchRecord.checkYourAnswers.label.weightBelow') }, value: { text: details.weightBelowMinimumRetained ~ " " ~ details.weightUnit } },
        { key: { text: t('web.record-details.index.copy.42.1') }, value: { text: details.weightLegallyDiscarded ~ " " ~ details.weightUnit } }
      ] }) }}

      <h2 class="govuk-heading-l">{{ t('catchRecord.checkYourAnswers.section.speciesNotLanded') }}</h2>
      {{ govukSummaryList({ rows: [
        { key: { text: t('web.record-details.index.copy.47.1') }, value: { text: t('summary.yes') if details.catchNotLanded else t('summary.no') } },
        { key: { text: t('catchRecord.checkYourAnswers.label.speciesName') }, value: { text: details.notLandedSpecies } },
        { key: { text: t('catchRecord.landingStorageSpecies.weight') }, value: { text: details.notLandedWeightAboveMinimumKept } }
      ] }) }}
      {% endif %}
      {% if not readOnly %}
      <div class="govuk-button-group">
        {{ govukButton({
          text: t('web.record-details.index.copy.55.1'),
          href: "/records/" + recordId + "/edit-reason"
        }) }}
        {# Download PDF is intentionally inert in this walkthrough (no PDF generation) #}
        {{ govukButton({
          text: t('web.record-details.index.copy.60.1'),
          classes: "govuk-button--secondary",
          type: "button"
        }) }}
      </div>
      {% endif %}
    </div>
  </div>
{% endblock %}
