{% extends 'layouts/page.njk' %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="post" novalidate>
        <span class="govuk-caption-l">{{ caption }}</span>
        <h1 class="govuk-heading-xl">{{ heading }}</h1>
        <p class="govuk-body">{{ bodyText[0] }}</p>
        <p class="govuk-body">{{ bodyText[1] }}</p>

        {{ govukRadios({
          name: "statisticalArea",
          fieldset: {
            legend: {
              text: "Select a statistical sub area",
              classes: "govuk-visually-hidden"
            }
          },
          items: areaOptions,
          errorMessage: { text: fieldErrors.statisticalArea } if fieldErrors.statisticalArea else false,
          attributes: { "data-statistical-area-options": "" }
        }) }}

        <p class="app-statistical-area-search__coordinates govuk-body"{% if not selectedAreaCoordinatesText %} hidden{% endif %} aria-live="polite" data-statistical-area-coordinates>
          Coordinates: <span data-statistical-area-coordinates-value>{{ selectedAreaCoordinatesText }}</span>
        </p>

        <div class="govuk-!-margin-bottom-9"{% if selectedArea != 'other' %} hidden{% endif %} data-statistical-area-search-panel>
          <div class="app-statistical-area-search__control govuk-input--width-30 govuk-!-margin-bottom-0">
            {{ govukInput({
              id: "alternativeStatisticalArea",
              name: "alternativeStatisticalArea",
              label: {
                text: "Statistical sub area - For example, 46E45",
                classes: "govuk-!-margin-bottom-4"
              },
              classes: "app-statistical-area-search__input app-autocomplete__input",
              inputWrapper: { classes: "app-autocomplete" },
              formGroup: {
                afterInput: {
                  html: '<span class="app-autocomplete__arrow" aria-hidden="true"></span>'
                }
              },
              value: alternativeStatisticalArea,
              errorMessage: { text: fieldErrors.alternativeStatisticalArea } if fieldErrors.alternativeStatisticalArea else false,
              attributes: {
                autocomplete: "off",
                placeholder: "Start typing to display the list",
                "aria-autocomplete": "list",
                "aria-controls": "statistical-area-results",
                "aria-expanded": "false",
                "data-statistical-area-search": ""
              }
            }) }}
          </div>

          <ul id="statistical-area-results" class="govuk-list app-statistical-area-search__results govuk-input--width-30" role="listbox" hidden data-statistical-area-results></ul>
        </div>

        {{ govukButton({ text: "Save and continue" }) }}
      </form>
    </div>
  </div>
{% endblock %}
