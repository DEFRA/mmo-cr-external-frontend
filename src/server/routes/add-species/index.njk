{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="post" novalidate>
        <h1 class="govuk-label-wrapper">
          <span class="govuk-caption-l">{{ caption }}</span>
          <label class="govuk-label govuk-label--xl" for="species">{{ heading }}</label>
        </h1>

        <div class="govuk-form-group{{ ' govuk-form-group--error' if fieldErrors.species }}">
          {% if fieldErrors.species %}
            <p id="species-error" class="govuk-error-message">
              <span class="govuk-visually-hidden">Error:</span> {{ fieldErrors.species }}
            </p>
          {% endif %}
          <input
            class="govuk-input"
            id="species"
            name="species"
            type="text"
            list="species-options"
            autocomplete="off"
            placeholder="Start typing to display the list"
            {% if fieldErrors.species %}aria-describedby="species-error"{% endif %}
          >
          <datalist id="species-options">
            {% for label in speciesOptionLabels %}
              <option value="{{ label }}"></option>
            {% endfor %}
          </datalist>
        </div>

        {{ govukButton({
          text: "Save and continue",
          classes: "govuk-!-margin-top-6"
        }) }}
      </form>
    </div>
  </div>
{% endblock %}
