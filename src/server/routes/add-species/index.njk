{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="post" novalidate>
        <h1 class="govuk-label-wrapper">
          <span class="govuk-caption-l">{{ caption }}</span>
          <label class="govuk-label govuk-label--xl" for="species">
            {{ heading }}
            {% if vesselName %}<span class="govuk-!-display-block">{{ vesselName }}</span>{% endif %}
          </label>
        </h1>

        <div class="govuk-form-group app-species-search{{ ' govuk-form-group--error' if fieldErrors.species }}">
          {% if fieldErrors.species %}
            <p id="species-error" class="govuk-error-message">
              <span class="govuk-visually-hidden">Error:</span> {{ fieldErrors.species }}
            </p>
          {% endif %}
          <select
            class="govuk-select govuk-!-width-full"
            id="species"
            name="species"
            {% if fieldErrors.species %}aria-describedby="species-error"{% endif %}
            data-species-search
          >
            <option value="">Start typing to display the list</option>
            {% for label in speciesOptionLabels %}
              <option value="{{ label }}">{{ label }}</option>
            {% endfor %}
          </select>
        </div>

        {{ govukButton({
          text: "Save and continue",
          classes: "govuk-!-margin-top-6"
        }) }}
      </form>
    </div>
  </div>
{% endblock %}
