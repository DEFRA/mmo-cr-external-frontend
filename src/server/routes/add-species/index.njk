{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="post" novalidate>
        <h1 class="govuk-label-wrapper">
          <span class="govuk-caption-l">{{ caption }}</span>
          <label class="govuk-label govuk-label--xl" for="species">
            {{ heading }}{% if vesselName %} {{ vesselName }}{% endif %}
          </label>
        </h1>

        <div class="govuk-form-group app-species-search{{ ' govuk-form-group--error' if fieldErrors.species }}">
          {% if fieldErrors.species %}
            <p id="species-error" class="govuk-error-message">
              <span class="govuk-visually-hidden">{{ t('a11y.errorPrefix') }}</span> {{ fieldErrors.species }}
            </p>
          {% endif %}
          <select
            class="govuk-select govuk-!-width-full"
            id="species"
            name="species"
            {% if fieldErrors.species %}aria-describedby="species-error"{% endif %}
            data-species-search
            data-autocomplete-placeholder="{{ t('common.autocomplete.placeholder') }}"
            data-autocomplete-no-results="{{ t('autocomplete.noResults') }}"
            data-autocomplete-status-query-too-short="{{ t('autocomplete.status.queryTooShort') }}"
            data-autocomplete-status-no-results="{{ t('autocomplete.status.noResults') }}"
            data-autocomplete-status-selected-option="{{ t('autocomplete.status.selectedOption') }}"
            data-autocomplete-status-results="{{ t('autocomplete.status.results') }}"
            data-autocomplete-assistive-hint="{{ t('autocomplete.assistiveHint') }}"
          >
            <option value="">{{ t('common.autocomplete.placeholder') }}</option>
            {% for label in speciesOptionLabels %}
              <option value="{{ label }}">{{ label }}</option>
            {% endfor %}
          </select>
        </div>

        {{ govukButton({
          text: t('common.button.saveAndContinue'),
          classes: "govuk-!-margin-top-6"
        }) }}
      </form>
    </div>
  </div>
{% endblock %}
