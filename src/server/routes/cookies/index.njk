{% extends 'layouts/page.njk' %}
{% from 'govuk/components/table/macro.njk' import govukTable %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ appHeading({ text: heading, columnClasses: 'govuk-grid-column-full' }) }}

      <p class="govuk-body">{{ t('cookies.intro') }}</p>
      <h2 class="govuk-heading-m">{{ t("cookies.essential.heading") }}</h2>
      <p class="govuk-body">{{ t('cookies.essential.body') }}</p>

      {{ govukTable({
        caption: t('cookies.table.caption'),
        captionClasses: 'govuk-visually-hidden',
        head: [
          { text: t('cookies.table.name') },
          { text: t('cookies.table.purpose') },
          { text: t('cookies.table.expires') }
        ],
        rows: [[
          { text: cookieName },
          { text: t('cookies.table.sessionPurpose') },
          { text: cookieExpiry }
        ], [
          { text: 'lang' },
          { text: t('cookies.lang.purpose') },
          { text: t('cookies.lang.expiry') }
        ]]
      }) }}

      <h2 class="govuk-heading-m">{{ t("cookies.managing.heading") }}</h2>
      <p class="govuk-body">{{ t('cookies.managing.body') }}</p>
      {% set privacyLink %}<a class="govuk-link" href="/privacy-notice">{{ t('privacyNotice.title') }}</a>{% endset %}
      <p class="govuk-body">{{ tHtml('cookies.managing.privacy', { link: privacyLink | safe }) }}</p>
    </div>
  </div>
{% endblock %}