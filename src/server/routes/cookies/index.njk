{% extends 'layouts/page.njk' %}
{% from 'govuk/components/table/macro.njk' import govukTable %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ appHeading({ text: heading, columnClasses: 'govuk-grid-column-full' }) }}

      <p class="govuk-body">Cookies are small files saved on your phone, tablet or computer when you visit a website.</p>
      <h2 class="govuk-heading-m">Essential cookies</h2>
      <p class="govuk-body">This service uses an essential session cookie to keep you signed in and remember your progress while you record your catch. This cookie is necessary for the service to work and does not require your consent.</p>

      {{ govukTable({
        caption: 'Essential session cookie',
        captionClasses: 'govuk-visually-hidden',
        head: [
          { text: 'Name' },
          { text: 'Purpose' },
          { text: 'Expires' }
        ],
        rows: [[
          { text: cookieName },
          { text: 'Keeps you signed in and remembers your progress.' },
          { text: cookieExpiry }
        ]]
      }) }}

      <h2 class="govuk-heading-m">Managing cookies</h2>
      <p class="govuk-body">You can delete or block cookies in your browser settings. If you block the essential session cookie, you will not be able to sign in or save your progress in this service.</p>
      <p class="govuk-body">Read our <a class="govuk-link" href="/privacy-notice">privacy notice</a> for information about how we use your personal data.</p>
    </div>
  </div>
{% endblock %}