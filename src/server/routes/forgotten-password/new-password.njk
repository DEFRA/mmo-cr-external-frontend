{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/password-input/macro.njk" import govukPasswordInput %}

{% macro passwordField(id, label, error) %}
  {{ govukPasswordInput({
    label: { text: label },
    id: id,
    name: id,
    autocomplete: "new-password",
    errorMessage: { text: error } if error,
    showPasswordText: t('common.passwordInput.show'),
    hidePasswordText: t('common.passwordInput.hide'),
    showPasswordAriaLabelText: t('common.passwordInput.showAriaLabel'),
    hidePasswordAriaLabelText: t('common.passwordInput.hideAriaLabel'),
    passwordShownAnnouncementText: t('common.passwordInput.shownAnnouncement'),
    passwordHiddenAnnouncementText: t('common.passwordInput.hiddenAnnouncement')
  }) }}
{% endmacro %}

{% block pageContent %}
  {{ appHeading({ text: heading }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <p class="govuk-body">{{ t('forgottenPassword.newPassword.hint') }}</p>

      <form method="post" action="/forgotten-password/new-password" novalidate>
        {{ passwordField("password", t('forgottenPassword.newPassword.label'), fieldErrors.password) }}
        {{ passwordField("confirmPassword", t('forgottenPassword.newPassword.confirmLabel'), fieldErrors.confirmPassword) }}

        {{ govukButton({ text: t('common.button.saveAndContinue') }) }}
      </form>
    </div>
  </div>
{% endblock %}
