{% extends 'layouts/page.njk' %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block pageContent %}
  {{ appHeading({ text: heading }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if notice %}
        {{ govukNotificationBanner({ type: "success", text: notice }) }}
      {% endif %}

      <p class="govuk-body">{{ t('forgottenPassword.code.intro') }}</p>
      <p class="govuk-body">{{ t('forgottenPassword.code.expiry') }}</p>

      <form method="post" action="/forgotten-password/code" novalidate>
        {{ govukInput({
          label: { text: t('forgottenPassword.code.label') },
          id: "code",
          name: "code",
          inputmode: "numeric",
          autocomplete: "one-time-code",
          spellcheck: false,
          classes: "govuk-input--width-10",
          errorMessage: { text: fieldErrors.code } if fieldErrors.code
        }) }}

        <div class="govuk-button-group">
          {{ govukButton({ text: t('common.button.continue') }) }}
          {{ govukButton({
            text: t('forgottenPassword.code.button.resend'),
            classes: "govuk-button--secondary",
            attributes: { formaction: "/forgotten-password/code/resend" }
          }) }}
        </div>
      </form>
    </div>
  </div>
{% endblock %}
