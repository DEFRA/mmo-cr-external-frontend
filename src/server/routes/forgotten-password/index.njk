{% extends 'layouts/page.njk' %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="{{ 'govuk-grid-column-two-thirds' if sent else 'govuk-grid-column-full' }}">
      {% if sent %}
        {{ govukPanel({ titleText: heading, text: email, classes: "app-password-reset-confirmation" }) }}

        <h2 class="govuk-heading-m">{{ t('common.whatHappensNext') }}</h2>
        <p class="govuk-body">{{ t('common.passwordReset.clickLink') }}</p>
        <p class="govuk-body">{{ t('common.passwordReset.checkSpam') }}</p>
        {{ govukButton({ text: t('signIn.button'), href: "/sign-in" }) }}
      {% else %}
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-8">{{ heading }}</h1>
        <p class="govuk-body govuk-!-margin-bottom-5">{{ t('forgottenPassword.intro') }}</p>

        <form method="post" action="/forgotten-password" novalidate>
          {{ govukInput({
            id: "email",
            name: "email",
            type: "email",
            autocomplete: "email",
            classes: "govuk-input--width-20",
            label: { text: t('common.emailAddress') },
            value: email,
            errorMessage: { text: fieldErrors.email } if fieldErrors.email else false,
            attributes: { spellcheck: "false", autocapitalize: "none" }
          }) }}

          {{ govukButton({ text: t('forgottenPassword.button') }) }}
        </form>
      {% endif %}
    </div>
  </div>
{% endblock %}