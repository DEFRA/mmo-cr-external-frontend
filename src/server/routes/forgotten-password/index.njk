{% extends 'layouts/page.njk' %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="{{ 'govuk-grid-column-two-thirds' if sent else 'govuk-grid-column-full' }}">
      {% if sent %}
        {{ govukPanel({ titleText: heading, text: email, classes: "app-password-reset-confirmation" }) }}

        <h2 class="govuk-heading-m">What happens next</h2>
        <p class="govuk-body">Click the link in the email to reset your password.</p>
        <p class="govuk-body">If you do not receive the email check your spam folder.</p>
        {{ govukButton({ text: "Sign in", href: "/sign-in" }) }}
      {% else %}
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-8">{{ heading }}</h1>
        <p class="govuk-body govuk-!-margin-bottom-5">Enter your email address and we will send you a link to reset your password.</p>

        <form method="post" action="/forgotten-password" novalidate>
          {{ govukInput({
            id: "email",
            name: "email",
            type: "email",
            autocomplete: "email",
            classes: "govuk-input--width-20",
            label: { text: "Email address" },
            value: email,
            errorMessage: { text: fieldErrors.email } if fieldErrors.email else false,
            attributes: { spellcheck: "false", autocapitalize: "none" }
          }) }}

          {{ govukButton({ text: "Send email" }) }}
        </form>
      {% endif %}
    </div>
  </div>
{% endblock %}