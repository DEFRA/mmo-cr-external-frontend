{% extends 'layouts/page.njk' %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l" data-testid="app-edit-reason-caption">{{ reference }}</span>

      <form method="post" novalidate>
        {{ govukTextarea({
          name: "editReason",
          id: "editReason",
          label: {
            text: heading,
            classes: "govuk-label--xl",
            isPageHeading: true
          },
          hint: {
            html: '<p class="govuk-body">Include:</p><ul class="govuk-list govuk-list--bullet"><li>what you are changing</li><li>why are you changing it</li><li>which office requested it, if applicable</li><li>the date change was made</li></ul>'
          },
          value: values.editReason if values else "",
          errorMessage: { text: fieldErrors.editReason } if fieldErrors.editReason else false
        }) }}

        {{ govukWarningText({
          text: "You must have a valid reason for editing this catch record. Editing a catch record without a valid reason may be an offence and could result in enforcement action.",
          iconFallbackText: "Warning"
        }) }}

        {{ govukButton({ text: "Save and continue" }) }}
      </form>
    </div>
  </div>
{% endblock %}
