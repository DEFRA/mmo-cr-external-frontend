{% extends 'layouts/page.njk' %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% block notification %}{% endblock %}

{% block pageContent %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if notification %}
        {{ govukNotificationBanner(notification) }}
      {% elif tripEndDate %}
        {{ govukNotificationBanner({
          titleText: t('common.important'),
          text: t('web.edit-catch-record-reason.index.copy.17.1') + (tripEndDate | formatDate("d MMMM yyyy")) + "."
        }) }}
      {% endif %}

      <span class="govuk-caption-l" data-testid="app-edit-reason-caption">{{ reference }}</span>

      <form method="post" novalidate>
        {% set hintHtml %}<p class="govuk-body govuk-!-margin-bottom-2">{{ t('web.edit-catch-record-reason.index.copy.37.1') }}</p><ul class="govuk-list govuk-list--bullet govuk-!-margin-bottom-0"><li>{{ t('web.edit-catch-record-reason.index.copy.37.2') }}</li><li>{{ t('web.edit-catch-record-reason.index.copy.37.3') }}</li><li>{{ t('web.edit-catch-record-reason.index.copy.37.4') }}</li><li>{{ t('web.edit-catch-record-reason.index.copy.37.5') }}</li></ul>{% endset %}
        {% if reasonKey %}<input type="hidden" name="reasonKey" value="{{ reasonKey }}">{% endif %}
        {{ govukTextarea({
          name: "editReason",
          id: "editReason",
          rows: 9,
          formGroup: { classes: "govuk-!-margin-bottom-8" },
          label: {
            text: heading,
            classes: "govuk-label--xl govuk-!-margin-bottom-7",
            isPageHeading: true
          },
          hint: {
            classes: "govuk-!-margin-bottom-8",
            html: hintHtml
          },
          value: values.editReason if values else "",
          errorMessage: { text: fieldErrors.editReason } if fieldErrors.editReason else false
        }) }}

        {{ govukWarningText({
          text: t('web.edit-catch-record-reason.index.copy.44.1'),
          iconFallbackText: t('govuk.warningText.iconFallback'),
          classes: "govuk-!-margin-bottom-9"
        }) }}

        {{ govukButton({ text: t('common.button.saveAndContinue'), classes: "govuk-!-margin-top-4" }) }}
      </form>
    </div>
  </div>
{% endblock %}
