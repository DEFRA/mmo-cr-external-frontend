{% extends 'layouts/page.njk' %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block pageContent %}
  {% set radioErrorMessage = { text: fieldErrors.catchNotLanded } if fieldErrors.catchNotLanded else false %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <form method="post" novalidate>
        {{ govukRadios({
          name: "catchNotLanded",
          fieldset: {
            legend: {
              html: '<span class="govuk-caption-l">' ~ (caption | escape) ~ '</span>' ~ (heading | escape),
              isPageHeading: true,
              classes: "govuk-fieldset__legend--xl"
            }
          },
          errorMessage: radioErrorMessage,
          items: [
            { value: "yes", text: "Yes", checked: catchNotLanded === true },
            { value: "no", text: "No", checked: catchNotLanded === false }
          ]
        }) }}

        {{ govukButton({ text: "Save and continue" }) }}
      </form>
    </div>
  </div>
{% endblock %}
