{% from "govuk/components/back-link/macro.njk" import govukBackLink %}

{% set currentLang = params.language.current | default('en', true) %}
{% set languages = [
  { code: 'en', text: t('header.language.toEnglish') },
  { code: 'cy', text: t('header.language.toWelsh') }
] %}

<div class="app-page-navigation" data-testid="app-page-navigation">
  {% if params.backLink and params.backLink.href %}
    {{ govukBackLink({
      href: params.backLink.href,
      text: params.backLink.text | default(t('header.back'), true),
      attributes: { "data-testid": "app-page-navigation-back-link" }
    }) }}
  {% endif %}

  <nav class="app-page-navigation__language" aria-label="{{ t('layout.language.navLabel') }}" data-testid="app-page-navigation-language">
    <ul class="app-page-navigation__language-list">
      {% for language in languages %}
        {% if not loop.first %}
          <li class="app-page-navigation__language-item" aria-hidden="true">|</li>
        {% endif %}
        <li class="app-page-navigation__language-item">
          {% if language.code == currentLang %}
            <span lang="{{ language.code }}" aria-current="true" data-testid="app-page-navigation-language-current">{{ language.text }}</span>
          {% else %}
            <a lang="{{ language.code }}" hreflang="{{ language.code }}" href="{{ params.language.href }}" class="govuk-link govuk-link--no-visited-state" data-testid="app-page-navigation-language-link">{{ language.text }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </nav>
</div>
