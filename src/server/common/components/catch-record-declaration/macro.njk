{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% macro appCatchRecordDeclaration(fieldErrors, showLegacyHeadingBeforeButton = false, reviewDesign = false, submissionKey = null) %}
  {% if reviewDesign %}
    <p class="govuk-body">{{ t('declaration.review.agreement') }}</p>
    {{ govukWarningText({
      text: t('declaration.review.warning'),
      iconFallbackText: t('govuk.warningText.iconFallback')
    }) }}
  {% else %}
  {{ govukWarningText({
    text: t("declaration.warning"),
    iconFallbackText: t('govuk.warningText.iconFallback')
  }) }}

  <p class="govuk-body">{{ t('web.common.components.catch-record-declaration.macro.copy.11.1') }}</p>
  <ul class="govuk-list govuk-list--bullet">
    <li>{{ t('catchRecord.checkYourAnswers.declaration.bullet.weight') }}</li>
    <li>{{ t('catchRecord.checkYourAnswers.declaration.bullet.tolerance') }}</li>
    <li>{{ t('catchRecord.checkYourAnswers.declaration.bullet.action') }}</li>
  </ul>
  {% endif %}

  <form method="post" novalidate>
    {% if submissionKey %}<input type="hidden" name="submissionKey" value="{{ submissionKey }}">{% endif %}
    {% if not reviewDesign %}
      {{ govukCheckboxes({
        name: "confirmAccurate",
        fieldset: {
          legend: {
            text: t('web.common.components.catch-record-declaration.macro.copy.25.1'),
            classes: "govuk-visually-hidden"
          }
        },
        errorMessage: { text: fieldErrors.confirmAccurate } if fieldErrors.confirmAccurate else false,
        items: [
          {
            value: "true",
            text: t('web.common.components.catch-record-declaration.macro.copy.33.1')
          }
        ]
      }) }}
    {% endif %}

    {# Reproduces a duplicate heading present in the create-mode design's PNG only #}
    {% if showLegacyHeadingBeforeButton %}
      <h2 class="govuk-heading-l">{{ t('web.common.components.catch-record-declaration.macro.copy.41.1') }}</h2>
    {% endif %}

    {{ govukButton({ text: t('catchRecord.checkYourAnswers.accept') }) }}
  </form>
{% endmacro %}
